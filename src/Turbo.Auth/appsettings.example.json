{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "https://app.example.com"
    ]
  },
  "Diagnostics": {
    "EnableSensitiveDataLogging": false
  },
  "AiRouting": {
    "FailureThreshold": 3,
    "BreakDurationSeconds": 60
  },
  "Jwt": {
    "Issuer": "turbo-ai-server",
    "Audience": "turbo-ai-client",
    "SecretKey": "Set-a-long-random-secret-through-environment-specific-configuration",
    "RefreshTokenPepper": "Set-a-separate-long-random-refresh-token-pepper-through-environment-specific-configuration",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30,
    "AuthenticationStateCacheSeconds": 60
  },
  "ConnectionStrings": {
    "ciko": "server=localhost;port=3306;database=turboai;user=turboai;password=replace-me;Charset=utf8mb4",
    "Redis": "localhost:6379"
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:6000"
      }
    }
  }
}
